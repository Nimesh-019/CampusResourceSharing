@model IEnumerable<CampusResourceSharing.Models.Request>

@{
    ViewData["Title"] = "My Request History";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold mb-1">My Request History</h2>
            <p class="text-muted mb-0">History of resource borrowing requests submitted by you.</p>
        </div>
        <a asp-controller="Item" asp-action="Index" class="btn btn-primary fw-semibold">
            Browse Available Items
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm py-4 text-center">
            <h5 class="alert-heading mb-1">No Request History</h5>
            <p class="mb-3 text-muted">You have not submitted any item requests yet.</p>
            <a asp-controller="Item" asp-action="Index" class="btn btn-primary btn-sm">Browse Items to Borrow</a>
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle bg-white mb-0 border">
                <thead class="table-dark">
                    <tr>
                        <th>Requested Item</th>
                        <th>Sharer</th>
                        <th>Duration</th>
                        <th>Requested On</th>
                        <th>Message</th>
                        <th>Request Status</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>
                                <strong>@(request.Item?.Name ?? "Item #" + request.ItemId)</strong>
                                <br />
                                <small class="text-muted">Category: @request.Item?.Category</small>
                            </td>
                            <td>
                                @if (request.Item?.Owner != null)
                                {
                                    <div class="fw-semibold">@request.Item.Owner.FullName</div>
                                    <small class="text-muted">Dept: @request.Item.Owner.Department</small>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @request.StartDate.ToString("MMM dd, yyyy") &mdash; @request.EndDate.ToString("MMM dd, yyyy")
                                </span>
                                <br />
                                <small class="text-muted">
                                    @((request.EndDate.Date - request.StartDate.Date).Days + 1) day(s)
                                </small>
                            </td>
                            <td>
                                @request.RequestedAt.ToString("MMM dd, yyyy HH:mm")
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(request.Message))
                                {
                                    <span>@request.Message</span>
                                }
                                else
                                {
                                    <span class="text-muted small">No message</span>
                                }
                            </td>
                            <!-- Request Status (Pending / Accepted / Rejected) -->
                            <td>
                                @if (request.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (request.Status == "Accepted")
                                {
                                    <span class="badge bg-success">Accepted</span>
                                }
                                else if (request.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@request.Status</span>
                                }
                            </td>
                            <!-- Borrowing Status (Upcoming / Ongoing / Completed for approved; pending/rejected preserved) -->
                            <td>
                                @if (request.Status == "Accepted")
                                {
                                    @if (request.BorrowingStatus == "Upcoming")
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Upcoming</span>
                                    }
                                    else if (request.BorrowingStatus == "Ongoing")
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">Ongoing</span>
                                    }
                                    else if (request.BorrowingStatus == "Completed")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Completed</span>
                                    }
                                }
                                else if (request.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (request.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@request.Status</span>
                                }
                            </td>
                            <!-- Actions -->
                            <td class="text-end">
                                @if (request.Status == "Pending")
                                {
                                    <form asp-action="Cancel" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@request.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to cancel this request?');">
                                            Cancel Request
                                        </button>
                                    </form>
                                }
                                else if (request.Status == "Accepted")
                                {
                                    @if (request.BorrowingStatus == "Completed")
                                    {
                                        <a asp-controller="Review" asp-action="Index" asp-route-itemId="@request.ItemId" class="btn btn-sm btn-outline-primary fw-semibold">
                                            Review Item
                                        </a>
                                    }
                                    else if (request.BorrowingStatus == "Ongoing")
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">Active Borrowing</span>
                                    }
                                    else if (request.BorrowingStatus == "Upcoming")
                                    {
                                        <span class="text-muted small">Not Started</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
