@model CampusResourceSharing.ViewModels.ItemReviewsViewModel

@{
    ViewData["Title"] = $"Reviews - {Model.Item.Name}";
    var today = DateTime.Today;
}

<div class="container mt-4 mb-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-3">
            <li class="breadcrumb-item">
                <a asp-controller="Item" asp-action="Index" class="text-decoration-none">Available Items</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Item" asp-action="Details" asp-route-id="@Model.Item.Id" class="text-decoration-none">@Model.Item.Name</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Reviews</li>
        </ol>
    </nav>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Item Overview Header Card -->
    <div class="card shadow-sm border-0 mb-4 bg-white">
        <div class="card-body p-3 p-md-4">
            <div class="row align-items-center g-3">
                <div class="col-auto">
                    @if (!string.IsNullOrEmpty(Model.Item.ImagePath))
                    {
                        <img src="@Model.Item.ImagePath" class="rounded border shadow-sm" style="width: 110px; height: 110px; object-fit: cover;" alt="@Model.Item.Name" />
                    }
                    else
                    {
                        <div class="rounded border bg-light d-flex align-items-center justify-content-center text-muted" style="width: 110px; height: 110px;">
                            <span class="small fw-medium">No Image</span>
                        </div>
                    }
                </div>

                <div class="col">
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-1">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@Model.Item.Category</span>
                        @if (!string.IsNullOrEmpty(Model.Item.Condition))
                        {
                            <span class="badge bg-secondary-subtle text-dark border">@Model.Item.Condition</span>
                        }
                        @if (Model.Item.IsAvailable)
                        {
                            <span class="badge bg-success">Available</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Unavailable</span>
                        }
                    </div>

                    <h2 class="fw-bold text-dark mb-1">@Model.Item.Name</h2>

                    @if (Model.Item.Owner != null)
                    {
                        <p class="text-muted small mb-0">
                            <strong>Shared by:</strong> @Model.Item.Owner.FullName
                            @if (!string.IsNullOrEmpty(Model.Item.Owner.Department))
                            {
                                <span>(@Model.Item.Owner.Department)</span>
                            }
                        </p>
                    }
                </div>

                <div class="col-12 col-md-auto text-md-end border-top border-md-0 pt-3 pt-md-0">
                    <div class="d-flex flex-wrap gap-2 justify-content-md-end">
                        <a asp-controller="Item" asp-action="Details" asp-route-id="@Model.Item.Id" class="btn btn-outline-secondary btn-sm fw-semibold">
                            Item Details
                        </a>
                        @if (Model.Item.IsAvailable && !Model.IsOwner)
                        {
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <a asp-controller="Request" asp-action="Create" asp-route-itemId="@Model.Item.Id" class="btn btn-primary btn-sm fw-semibold">
                                    Request Item
                                </a>
                            }
                            else
                            {
                                <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Create", "Request", new { itemId = Model.Item.Id })" class="btn btn-primary btn-sm">
                                    Login to Request
                                </a>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Rating Summary & Write Review Section -->
    <div class="row g-4 mb-4">
        <!-- Rating Summary Box -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100 bg-white">
                <div class="card-body p-4 text-center d-flex flex-column justify-content-center">
                    <h5 class="fw-bold text-muted mb-2">Item Rating</h5>
                    @if (Model.TotalReviews > 0)
                    {
                        <div class="display-4 fw-bold text-dark mb-1">@Model.AverageRating.ToString("0.0")</div>
                        <div class="mb-2 fs-5 text-warning">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(Model.AverageRating))
                                {
                                    <span>&#9733;</span>
                                }
                                else
                                {
                                    <span class="text-secondary opacity-25">&#9733;</span>
                                }
                            }
                        </div>
                        <p class="text-muted mb-0 small">
                            Based on <strong>@Model.TotalReviews</strong> @(Model.TotalReviews == 1 ? "review" : "reviews")
                        </p>
                    }
                    else
                    {
                        <div class="display-6 fw-bold text-secondary mb-1">&mdash;</div>
                        <div class="mb-2 fs-5 text-secondary opacity-25">
                            &#9733;&#9733;&#9733;&#9733;&#9733;
                        </div>
                        <p class="text-muted mb-0 small">No ratings yet</p>
                    }
                </div>
            </div>
        </div>

        <!-- Eligibility / Write Review Action Box -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100 bg-white">
                <div class="card-body p-4 d-flex flex-column justify-content-center">
                    @if (Model.IsEligibleToReview)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h4 class="fw-bold text-dark mb-1">You Are Eligible to Review!</h4>
                                <p class="text-muted small mb-0">You completed borrowing this item. Share your feedback to help campus peers.</p>
                            </div>
                            <button class="btn btn-primary fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#reviewFormCollapse" aria-expanded="true" aria-controls="reviewFormCollapse">
                                Write a Review
                            </button>
                        </div>

                        <!-- Form Collapse -->
                        <div class="collapse show" id="reviewFormCollapse">
                            <form asp-controller="Review" asp-action="Create" asp-route-itemId="@Model.Item.Id" method="post" class="border rounded p-3 bg-light mt-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ItemId" value="@Model.Item.Id" />
                                <input type="hidden" name="BorrowRequestId" value="@(Model.EligibleBorrowRequestId ?? Model.NewReview.BorrowRequestId)" />
                                <input type="hidden" name="NewReview.ItemId" value="@Model.Item.Id" />
                                <input type="hidden" name="NewReview.BorrowRequestId" value="@(Model.EligibleBorrowRequestId ?? Model.NewReview.BorrowRequestId)" />

                                <div class="mb-3">
                                    <label class="form-label fw-bold small text-dark mb-1">Rating (1 to 5 Stars) <span class="text-danger">*</span></label>
                                    <div class="d-flex gap-2 align-items-center flex-wrap">
                                        <div class="rating-stars fs-4 text-warning" id="starContainer" style="cursor: pointer;">
                                            <span class="star-item" data-value="1" title="1 Star - Poor">&#9733;</span>
                                            <span class="star-item" data-value="2" title="2 Stars - Fair">&#9733;</span>
                                            <span class="star-item" data-value="3" title="3 Stars - Good">&#9733;</span>
                                            <span class="star-item" data-value="4" title="4 Stars - Very Good">&#9733;</span>
                                            <span class="star-item" data-value="5" title="5 Stars - Excellent">&#9733;</span>
                                        </div>
                                        <select name="Rating" id="ratingSelect" class="form-select form-select-sm w-auto fw-semibold">
                                            <option value="5" selected="@(Model.NewReview.Rating == 5)">5 - Excellent</option>
                                            <option value="4" selected="@(Model.NewReview.Rating == 4)">4 - Very Good</option>
                                            <option value="3" selected="@(Model.NewReview.Rating == 3)">3 - Good</option>
                                            <option value="2" selected="@(Model.NewReview.Rating == 2)">2 - Fair</option>
                                            <option value="1" selected="@(Model.NewReview.Rating == 1)">1 - Poor</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="NewReview.Rating" class="text-danger small d-block"></span>
                                    @if (ViewData.ModelState["Rating"]?.Errors.Any() == true)
                                    {
                                        <span class="text-danger small d-block">@ViewData.ModelState["Rating"]!.Errors[0].ErrorMessage</span>
                                    }
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold small text-dark mb-1">Review Comment <span class="text-danger">*</span></label>
                                    <textarea name="Comment" class="form-control" rows="3" placeholder="Describe the item condition, your borrowing experience, and whether you recommend it to others...">@Model.NewReview.Comment</textarea>
                                    <span asp-validation-for="NewReview.Comment" class="text-danger small d-block"></span>
                                    @if (ViewData.ModelState["Comment"]?.Errors.Any() == true)
                                    {
                                        <span class="text-danger small d-block">@ViewData.ModelState["Comment"]!.Errors[0].ErrorMessage</span>
                                    }
                                </div>

                                <div class="d-flex justify-content-end gap-2">
                                    <button type="submit" class="btn btn-primary fw-bold px-4">
                                        Submit Review
                                    </button>
                                </div>
                            </form>
                        </div>
                    }
                    else if (Model.HasActiveBorrowing)
                    {
                        <div class="alert alert-info mb-0 border-0 bg-info-subtle">
                            <h6 class="fw-bold text-info-emphasis mb-1">Borrowing In Progress</h6>
                            <p class="mb-0 small text-info-emphasis">
                                @(Model.EligibilityMessage ?? "Your borrowing duration is currently active. You can write a review once your approved borrowing period has ended.")
                            </p>
                        </div>
                    }
                    else if (Model.HasAlreadyReviewedAll)
                    {
                        <div class="alert alert-success mb-0 border-0 bg-success-subtle">
                            <h6 class="fw-bold text-success-emphasis mb-1">&#10003; Review Submitted</h6>
                            <p class="mb-0 small text-success-emphasis">
                                You have already submitted a review for your completed borrowing. Thank you for helping the campus community!
                            </p>
                        </div>
                    }
                    else if (Model.IsOwner)
                    {
                        <div class="alert alert-secondary mb-0 border-0 bg-light">
                            <h6 class="fw-bold text-secondary mb-1">Item Owner</h6>
                            <p class="mb-0 small text-muted">
                                As the owner of this item, you cannot write a review for your own item. Reviews are written by students who borrowed it.
                            </p>
                        </div>
                    }
                    else if (!Model.IsUserLoggedIn)
                    {
                        <div class="text-center py-2">
                            <h6 class="fw-bold text-dark mb-1">Have you borrowed this item?</h6>
                            <p class="text-muted small mb-3">Log in to write a review after your approved borrowing period is completed.</p>
                            <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Index", "Review", new { itemId = Model.Item.Id })" class="btn btn-outline-primary btn-sm fw-semibold">
                                Login to Check Eligibility
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small py-2">
                            <h6 class="fw-bold text-dark mb-1">Review Eligibility</h6>
                            <p class="mb-0">
                                Only students who have requested, received owner approval, and completed the borrowing duration are eligible to write a review for this item.
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Reviews List Section -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold mb-0">Student Reviews</h3>
        <span class="badge bg-secondary fs-6">@Model.TotalReviews @(Model.TotalReviews == 1 ? "Review" : "Reviews")</span>
    </div>

    @if (!Model.Reviews.Any())
    {
        <div class="card shadow-sm border-0 py-5 text-center bg-white">
            <div class="card-body">
                <div class="fs-1 text-secondary opacity-50 mb-2">&#9734;</div>
                <h5 class="fw-bold text-dark mb-1">No reviews yet.</h5>
                <p class="text-muted small mb-0">
                    There are no reviews for this item yet. Reviews will appear here once students borrow this resource and their borrowing duration ends.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var review in Model.Reviews)
            {
                <div class="card shadow-sm border-0 bg-white">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h6 class="fw-bold text-dark mb-0">
                                    @(review.Reviewer?.FullName ?? "Student Reviewer")
                                </h6>
                                <div class="d-flex gap-2 align-items-center mt-1">
                                    @if (!string.IsNullOrEmpty(review.Reviewer?.Department))
                                    {
                                        <span class="text-muted small">Dept: @review.Reviewer.Department</span>
                                        <span class="text-muted small">&middot;</span>
                                    }
                                    <span class="badge bg-success-subtle text-success border border-success-subtle small py-0">
                                        &#10003; Verified Borrower
                                    </span>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fs-5 text-warning mb-0">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= review.Rating)
                                        {
                                            <span>&#9733;</span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary opacity-25">&#9733;</span>
                                        }
                                    }
                                </div>
                                <small class="text-muted">
                                    @review.CreatedAt.ToString("MMM dd, yyyy")
                                </small>
                            </div>
                        </div>

                        <p class="card-text text-dark mb-0 mt-2" style="white-space: pre-line;">
                            @review.Comment
                        </p>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const starContainer = document.getElementById("starContainer");
            const ratingSelect = document.getElementById("ratingSelect");

            if (starContainer && ratingSelect) {
                const stars = starContainer.querySelectorAll(".star-item");

                function updateStars(val) {
                    stars.forEach(star => {
                        const starVal = parseInt(star.getAttribute("data-value"), 10);
                        if (starVal <= val) {
                            star.classList.remove("text-secondary", "opacity-25");
                            star.classList.add("text-warning");
                        } else {
                            star.classList.remove("text-warning");
                            star.classList.add("text-secondary", "opacity-25");
                        }
                    });
                }

                stars.forEach(star => {
                    star.addEventListener("click", function () {
                        const val = parseInt(this.getAttribute("data-value"), 10);
                        ratingSelect.value = val;
                        updateStars(val);
                    });

                    star.addEventListener("mouseenter", function () {
                        const val = parseInt(this.getAttribute("data-value"), 10);
                        updateStars(val);
                    });
                });

                starContainer.addEventListener("mouseleave", function () {
                    const currentVal = parseInt(ratingSelect.value, 10);
                    updateStars(currentVal);
                });

                ratingSelect.addEventListener("change", function () {
                    updateStars(parseInt(this.value, 10));
                });

                // Initialize with current select value
                updateStars(parseInt(ratingSelect.value, 10));
            }
        });
    </script>
}
