@model IEnumerable<CampusResourceSharing.Models.Item>

@{
    ViewData["Title"] = "My Shared Items";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="fw-bold mb-1">My Shared Items</h1>
            <p class="text-muted mb-0">Items you have shared with fellow students</p>
        </div>
        <a asp-action="Create" class="btn btn-primary fw-bold">
            + Add Item
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4 shadow-sm">
            <h5 class="mb-1">You haven't shared any items yet</h5>
            <p class="mb-3 text-muted">Click the button below to share an item with your campus peers.</p>
            <a asp-action="Create" class="btn btn-primary fw-bold">+ Add Item Now</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img src="@item.ImagePath" class="card-img-top" style="height:200px; object-fit:cover;" alt="@item.Name" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light text-secondary" style="height:200px;">
                                <span class="fw-medium">No Image</span>
                            </div>
                        }

                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@item.Category</span>
                                <div class="d-flex gap-1">
                                    @if (item.Status == ItemStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if (item.Status == ItemStatus.Approved)
                                    {
                                        <span class="badge bg-success">Approved</span>
                                    }
                                    else if (item.Status == ItemStatus.Rejected)
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                    }

                                    @if (item.IsAvailable)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Available</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Unavailable</span>
                                    }
                                </div>
                            </div>

                            <h5 class="card-title fw-bold text-dark mb-1">@item.Name</h5>

                            <p class="card-text text-muted small mb-2">
                                @(string.IsNullOrEmpty(item.Description) ? "No description." : (item.Description.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description))
                            </p>
                        </div>

                        <div class="card-footer bg-white border-top-0 d-flex flex-wrap justify-content-between align-items-center gap-2 pb-3 pt-0">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">
                                Details
                            </a>

                            <div class="d-flex flex-wrap gap-1">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm fw-semibold">
                                    Edit
                                </a>
                                <a asp-action="History" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm fw-semibold">
                                    History
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm fw-semibold">
                                    Delete
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>