@model IEnumerable<CampusResourceSharing.Models.Item>

@{
    ViewData["Title"] = "Available Items";
}

<div class="container mt-4">

    <h1>Available Items</h1>

    <p class="text-muted">
        Items shared by other students
    </p>

    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card h-100 shadow-sm">

                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="@item.ImagePath"
                             class="card-img-top"
                             style="height:220px; object-fit:cover;"
                             alt="@item.Name">
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-light"
                             style="height:220px;">

                            <span class="text-muted">
                                No Image
                            </span>

                        </div>
                    }

                    <div class="card-body">

                        <h5 class="card-title">
                            @item.Name
                        </h5>

                        <p class="card-text">
                            @item.Description
                        </p>

                        <p>
                            <strong>Category:</strong>
                            @item.Category
                        </p>

                        <p>
                            <strong>Condition:</strong>
                            @item.Condition
                        </p>

                        <span class="badge bg-success">
                            Available
                        </span>

                    </div>

                    <div class="card-footer">

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-primary">
                            View Details
                        </a>

                        <a asp-controller="Request"
                           asp-action="Create"
                           asp-route-itemId="@item.Id"
                           class="btn btn-primary">
                            Request Item
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No items from other students are currently available.
        </div>
    }

</div>