@model CampusResourceSharing.ViewModels.ItemHistoryViewModel

@{
    ViewData["Title"] = $"Request History - {Model.Item.Name}";
    var today = DateTime.Today;
}

<div class="container mt-4 mb-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
            <li class="breadcrumb-item">
                <a asp-action="MyItems" class="text-decoration-none">My Shared Items</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                Item History
            </li>
        </ol>
    </nav>

    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="fw-bold mb-1">Item Request History</h2>
            <p class="text-muted mb-0">Complete chronological request and borrowing history for this item.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Details" asp-route-id="@Model.Item.Id" class="btn btn-outline-secondary btn-sm fw-semibold">
                Item Details
            </a>
            <a asp-action="MyItems" class="btn btn-outline-primary btn-sm fw-semibold">
                &larr; Back to My Items
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Item Summary Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3 p-md-4">
            <div class="row align-items-center g-3">
                <div class="col-auto">
                    @if (!string.IsNullOrEmpty(Model.Item.ImagePath))
                    {
                        <img src="@Model.Item.ImagePath"
                             class="rounded border shadow-sm"
                             style="width: 100px; height: 100px; object-fit: cover;"
                             alt="@Model.Item.Name" />
                    }
                    else
                    {
                        <div class="rounded border bg-light d-flex align-items-center justify-content-center text-muted"
                             style="width: 100px; height: 100px;">
                            <span class="small fw-medium">No Image</span>
                        </div>
                    }
                </div>

                <div class="col">
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-1">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                            @Model.Item.Category
                        </span>

                        @if (!string.IsNullOrEmpty(Model.Item.Condition))
                        {
                            <span class="badge bg-secondary-subtle text-dark border">
                                @Model.Item.Condition
                            </span>
                        }

                        @if (Model.Item.Status == ItemStatus.Pending)
                        {
                            <span class="badge bg-warning text-dark">Item Status: Pending Admin Approval</span>
                        }
                        else if (Model.Item.Status == ItemStatus.Approved)
                        {
                            <span class="badge bg-success">Item Status: Admin Approved</span>
                        }
                        else if (Model.Item.Status == ItemStatus.Rejected)
                        {
                            <span class="badge bg-danger">Item Status: Admin Rejected</span>
                        }

                        @if (Model.Item.IsAvailable)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle">Available</span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Unavailable</span>
                        }
                    </div>

                    <h4 class="fw-bold text-dark mb-1">@Model.Item.Name</h4>

                    <p class="text-muted small mb-0">
                        @(string.IsNullOrEmpty(Model.Item.Description) ? "No description provided." : Model.Item.Description)
                    </p>

                    <div class="text-muted small mt-1">
                        Shared on @Model.Item.CreatedAt.ToString("MMM dd, yyyy")
                    </div>
                </div>

                <div class="col-12 col-lg-auto border-top border-lg-start pt-3 pt-lg-0 ps-lg-4">
                    <div class="d-flex flex-wrap flex-lg-column gap-2 text-nowrap">
                        <div class="d-flex justify-content-between align-items-center gap-3">
                            <span class="small text-muted">Total Requests:</span>
                            <span class="badge bg-secondary">@Model.TotalRequests</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center gap-3">
                            <span class="small text-muted">Approved / Accepted:</span>
                            <span class="badge bg-success">@Model.ApprovedRequests</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center gap-3">
                            <span class="small text-muted">Pending:</span>
                            <span class="badge bg-warning text-dark">@Model.PendingRequests</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center gap-3">
                            <span class="small text-muted">Rejected:</span>
                            <span class="badge bg-danger">@Model.RejectedRequests</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- History Log Section -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">Request Timeline</h4>
        <span class="badge bg-secondary fs-6">Total: @Model.TotalRequests</span>
    </div>

    @if (!Model.Requests.Any())
    {
        <div class="alert alert-info shadow-sm py-5 text-center">
            <h5 class="alert-heading mb-1">No request history available for this item.</h5>
            <p class="mb-3 text-muted">No students have submitted borrowing requests for this item yet.</p>
            <a asp-action="MyItems" class="btn btn-outline-primary btn-sm fw-semibold">
                &larr; Back to My Shared Items
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded border">
            <table class="table table-hover align-middle bg-white mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Requester Info</th>
                        <th>Borrowing Duration</th>
                        <th>Requested On</th>
                        <th>Request Message</th>
                        <th>Status &amp; Owner Action</th>
                        <th>Status</th>
                        <th>Decision On</th>
                        <th class="text-end" style="min-width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int index = 1;
                    }
                    @foreach (var request in Model.Requests)
                    {
                        var isCurrentlyActive = request.IsOngoing;

                        <tr>
                            <td class="text-muted fw-semibold">
                                @(index++)
                            </td>

                            <!-- Requester Info -->
                            <td>
                                @if (request.Requester != null)
                                {
                                    <div class="fw-bold text-dark">@request.Requester.FullName</div>
                                    <small class="text-muted d-block">
                                        <strong>Dept:</strong> @(string.IsNullOrEmpty(request.Requester.Department) ? "—" : request.Requester.Department)
                                    </small>
                                    <small class="text-muted d-block">
                                        <strong>Email:</strong> @request.Requester.Email
                                    </small>
                                    @if (!string.IsNullOrEmpty(request.Requester.PhoneNumber))
                                    {
                                        <small class="text-primary d-block fw-semibold">
                                            <strong>Phone:</strong> @request.Requester.PhoneNumber
                                        </small>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">User ID: @request.RequesterId</span>
                                }
                            </td>

                            <!-- Borrowing Duration -->
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @request.StartDate.ToString("MMM dd, yyyy") &mdash; @request.EndDate.ToString("MMM dd, yyyy")
                                </span>
                                <div class="text-muted small mt-1">
                                    @((request.EndDate.Date - request.StartDate.Date).Days + 1) day(s) duration
                                </div>
                                @if (isCurrentlyActive)
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle mt-1">
                                        Currently Borrowed
                                    </span>
                                }
                            </td>

                            <!-- Requested On -->
                            <td>
                                <div class="fw-medium">@request.RequestedAt.ToString("MMM dd, yyyy")</div>
                                <small class="text-muted">@request.RequestedAt.ToString("hh:mm tt")</small>
                            </td>

                            <!-- Message -->
                            <td>
                                @if (!string.IsNullOrWhiteSpace(request.Message))
                                {
                                    <div class="text-break" style="max-width: 260px;">
                                        @request.Message
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">No message</span>
                                }
                            </td>

                            <!-- Status & Owner Decision -->
                            <td>
                                @if (request.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                    <small class="text-warning-emphasis d-block fw-semibold mt-1">
                                        Awaiting your response
                                    </small>
                                }
                                else if (request.Status == "Accepted")
                                {
                                    <span class="badge bg-success">Approved / Accepted</span>
                                    <small class="text-success d-block fw-semibold mt-1">
                                        &#10003; Approved by you
                                    </small>
                                }
                                else if (request.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                    <small class="text-danger d-block fw-semibold mt-1">
                                        &#10007; Rejected by you
                                    </small>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@request.Status</span>
                                }
                            </td>

                            <!-- Status (Upcoming / Ongoing / Completed for approved; pending/rejected preserved) -->
                            <td>
                                @if (request.Status == "Accepted")
                                {
                                    @if (request.BorrowingStatus == "Upcoming")
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Upcoming</span>
                                    }
                                    else if (request.BorrowingStatus == "Ongoing")
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">Ongoing</span>
                                    }
                                    else if (request.BorrowingStatus == "Completed")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Completed</span>
                                    }
                                }
                                else if (request.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (request.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@request.Status</span>
                                }
                            </td>

                            <!-- Decision Date & Time -->
                            <td>
                                @if (request.RespondedAt.HasValue)
                                {
                                    <div class="fw-medium">@request.RespondedAt.Value.ToString("MMM dd, yyyy")</div>
                                    <small class="text-muted">@request.RespondedAt.Value.ToString("hh:mm tt")</small>
                                }
                                else if (request.Status == "Pending")
                                {
                                    <span class="text-muted small fst-italic">Pending decision</span>
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">Not recorded</span>
                                }
                            </td>

                            <!-- Actions -->
                            <td class="text-end">
                                @if (request.Status == "Pending")
                                {
                                    <div class="d-inline-flex flex-column gap-1">
                                        <form asp-controller="Request" asp-action="Accept" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@request.Id" />
                                            <input type="hidden" name="returnUrl" value="@Url.Action("History", "Item", new { id = Model.Item.Id })" />
                                            <button type="submit" class="btn btn-sm btn-success fw-semibold w-100">
                                                Accept
                                            </button>
                                        </form>

                                        <form asp-controller="Request" asp-action="Reject" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@request.Id" />
                                            <input type="hidden" name="returnUrl" value="@Url.Action("History", "Item", new { id = Model.Item.Id })" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger fw-semibold w-100"
                                                    onclick="return confirm('Are you sure you want to reject this request?');">
                                                Reject
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
