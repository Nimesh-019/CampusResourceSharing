<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CampusResourceSharing</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CampusResourceSharing.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    @{
        var isLoginPage =
            ViewContext.RouteData.Values["area"]?.ToString() == "Identity" &&
            ViewContext.RouteData.Values["page"]?.ToString() == "/Account/Login";
    }

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-4 py-2">
            <div class="container">
                <a class="navbar-brand fw-bold text-primary fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    CampusResourceSharing
                </a>

                @if (!isLoginPage)
                {
                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target=".navbar-collapse"
                            aria-controls="navbarSupportedContent"
                            aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1 ms-3">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                @if (User.IsInRole("Admin"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-danger fw-bold" asp-area="Admin" asp-controller="Admin" asp-action="Index">Admin Dashboard</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark fw-medium" asp-area="Admin" asp-controller="Students" asp-action="Index">Students</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark fw-medium" asp-area="Admin" asp-controller="Items" asp-action="Pending">Pending Items</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark fw-medium" asp-area="Admin" asp-controller="Items" asp-action="Approved">Approved Items</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark fw-medium" asp-area="Admin" asp-controller="Items" asp-action="Rejected">Rejected Items</a>
                                    </li>
                                }
                                else
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Item" asp-action="Index">Available Items</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Item" asp-action="Create">Add Item</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Item" asp-action="MyItems">My Shared Items</a>
                                    </li>
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle text-dark fw-medium" href="#" id="requestsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            Requests
                                        </a>
                                        <ul class="dropdown-menu border-0 shadow-sm" aria-labelledby="requestsDropdown">
                                            <li><a class="dropdown-item py-2" asp-area="" asp-controller="Request" asp-action="IncomingRequests">Incoming Requests</a></li>
                                            <li><a class="dropdown-item py-2" asp-area="" asp-controller="Request" asp-action="MyRequests">Request History</a></li>
                                        </ul>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Item" asp-action="Index">Available Items</a>
                                </li>
                            }
                        </ul>
                        <partial name="_LoginPartial" />
                    </div>
                }
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 pb-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white mt-auto py-3">
        <div class="container text-center">
            &copy; 2026 - CampusResourceSharing &middot;
            <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>