# ===================================================
# CampusResourceSharing Environment Configuration Template
# ===================================================
# Copy this file to .env and fill in your actual values:
# cp .env.example .env

# --- Cloudinary Configuration ---
# You can set either individual keys or the full CLOUDINARY_URL:
CloudinarySettings__CloudName=YOUR_CLOUD_NAME
CloudinarySettings__ApiKey=YOUR_API_KEY
CloudinarySettings__ApiSecret=YOUR_API_SECRET

# Optional Alternative (Full connection string from Cloudinary dashboard):
# CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME

# --- Database Connection String (Optional: overrides appsettings.json) ---
# ConnectionStrings__DefaultConnection=Server=(localdb)\mssqllocaldb;Database=aspnet-CampusResourceSharing-bf34259d-c55a-40d8-97f5-13cd7ab28f07;Trusted_Connection=True;MultipleActiveResultSets=true

# --- ASP.NET Core Environment ---
ASPNETCORE_ENVIRONMENT=Development
