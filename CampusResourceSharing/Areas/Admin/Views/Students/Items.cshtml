@model IEnumerable<Item>

@{
    var student = ViewBag.Student as ApplicationUser;
    ViewData["Title"] = $"Items Shared by {student?.FullName ?? "Student"}";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="fw-bold mb-1">Items Shared by @student?.FullName</h1>
            <p class="text-muted mb-0">Email: @student?.Email &middot; Branch: @student?.Department</p>
        </div>
        <a asp-area="Admin" asp-controller="Students" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            &larr; Back to Students List
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4 shadow-sm">
            <h5 class="mb-1">This student has not uploaded any items</h5>
            <p class="mb-0 text-muted">Items created by this student will appear here.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img src="@item.ImagePath" class="card-img-top" style="height:200px; object-fit:cover;" alt="@item.Name" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light text-secondary" style="height:200px;">
                                <span class="fw-medium">No Image</span>
                            </div>
                        }

                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@item.Category</span>

                                @if (item.Status == ItemStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (item.Status == ItemStatus.Approved)
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else if (item.Status == ItemStatus.Rejected)
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                            </div>

                            <h5 class="card-title fw-bold text-dark mb-1">@item.Name</h5>

                            <p class="card-text text-muted small mb-2">
                                @(string.IsNullOrEmpty(item.Description) ? "No description." : (item.Description.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description))
                            </p>

                            <div class="small text-muted border-top pt-2 mt-2">
                                <strong>Condition:</strong> @(string.IsNullOrEmpty(item.Condition) ? "N/A" : item.Condition) <br />
                                <strong>Availability:</strong>
                                @if (item.IsAvailable)
                                {
                                    <span class="text-success fw-semibold">Available</span>
                                }
                                else
                                {
                                    <span class="text-danger fw-semibold">Unavailable</span>
                                }
                            </div>
                        </div>

                        <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center pb-3 pt-0">
                            @if (item.Status == ItemStatus.Pending)
                            {
                                <div class="d-flex gap-2 w-100">
                                    <form asp-area="Admin" asp-controller="Items" asp-action="Approve" asp-route-id="@item.Id" method="post" class="flex-fill">
                                        <button type="submit" class="btn btn-success btn-sm w-100 fw-bold">Approve</button>
                                    </form>
                                    <form asp-area="Admin" asp-controller="Items" asp-action="Reject" asp-route-id="@item.Id" method="post" class="flex-fill">
                                        <button type="submit" class="btn btn-danger btn-sm w-100 fw-bold">Reject</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small">Status: <strong>@item.Status</strong></span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
