@model ApplicationUser

@{
    ViewData["Title"] = "Student Details";
    int itemCount = ViewBag.ItemCount ?? 0;
}

<div class="container mt-4">
    <div class="mb-3">
        <a asp-area="Admin" asp-controller="Students" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            &larr; Back to Students List
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h4 class="fw-bold mb-0">Student Profile Information</h4>
            <a asp-area="Admin" asp-controller="Students" asp-action="Items" asp-route-id="@Model.Id" class="btn btn-primary btn-sm fw-semibold">
                View Shared Items (@itemCount)
            </a>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-md-6">
                    <label class="text-muted small fw-semibold text-uppercase">Full Name</label>
                    <p class="fs-5 fw-bold text-dark mb-0">@Model.FullName</p>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small fw-semibold text-uppercase">Email Address</label>
                    <p class="fs-5 text-dark mb-0">@Model.Email</p>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small fw-semibold text-uppercase">Phone Number</label>
                    <p class="fs-5 text-dark mb-0">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not Provided" : Model.PhoneNumber)</p>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small fw-semibold text-uppercase">College Branch / Department</label>
                    <p class="fs-5 text-dark mb-0">
                        <span class="badge bg-secondary-subtle text-dark border">
                            @(string.IsNullOrEmpty(Model.Department) ? "Not Provided" : Model.Department)
                        </span>
                    </p>
                </div>

                <div class="col-md-12">
                    <label class="text-muted small fw-semibold text-uppercase">Campus / Hostel Address</label>
                    <p class="fs-6 text-dark mb-0">@(string.IsNullOrEmpty(Model.Address) ? "Not Provided" : Model.Address)</p>
                </div>
            </div>
        </div>

        <div class="card-footer bg-light border-top d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small">User ID: @Model.Id</span>
            <a asp-area="Admin" asp-controller="Students" asp-action="Items" asp-route-id="@Model.Id" class="btn btn-primary fw-semibold">
                View Student's Items &rarr;
            </a>
        </div>
    </div>
</div>
