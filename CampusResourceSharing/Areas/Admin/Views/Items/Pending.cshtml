@model IEnumerable<Item>

@{
    ViewData["Title"] = "Pending Approval Items";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="fw-bold mb-1">Pending Approval Items</h1>
            <p class="text-muted mb-0">Review items submitted by students before making them visible to others</p>
        </div>
        <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            &larr; Back to Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-success text-center py-4 shadow-sm">
            <h5 class="mb-1">All clear! No pending items.</h5>
            <p class="mb-0 text-muted">There are currently no items waiting for administrator approval.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 border-top border-warning border-4">
                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img src="@item.ImagePath" class="card-img-top" style="height:200px; object-fit:cover;" alt="@item.Name" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light text-secondary" style="height:200px;">
                                <span class="fw-medium">No Image Uploaded</span>
                            </div>
                        }

                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@item.Category</span>
                                <span class="badge bg-warning text-dark">Pending</span>
                            </div>

                            <h5 class="card-title fw-bold text-dark mb-1">@item.Name</h5>

                            <p class="card-text text-muted small mb-3">
                                @(string.IsNullOrEmpty(item.Description) ? "No description provided." : (item.Description.Length > 90 ? item.Description.Substring(0, 90) + "..." : item.Description))
                            </p>

                            <div class="small border-top pt-2 text-muted">
                                <strong>Condition:</strong> @(string.IsNullOrEmpty(item.Condition) ? "N/A" : item.Condition) <br />
                                <strong>Submitted by:</strong> @(item.Owner?.FullName ?? "Unknown") <br />
                                <strong>Email:</strong> @(item.Owner?.Email ?? "N/A") <br />
                                <strong>Branch:</strong> @(item.Owner?.Department ?? "N/A") <br />
                                <strong>Submitted On:</strong> @item.CreatedAt.ToString("MMM dd, yyyy - hh:mm tt")
                            </div>
                        </div>

                        <div class="card-footer bg-white border-top-0 pb-3 pt-0">
                            <div class="d-flex gap-2">
                                <form asp-area="Admin" asp-controller="Items" asp-action="Approve" asp-route-id="@item.Id" method="post" class="flex-fill">
                                    <button type="submit" class="btn btn-success btn-sm w-100 fw-bold">
                                        &check; Approve
                                    </button>
                                </form>
                                <form asp-area="Admin" asp-controller="Items" asp-action="Reject" asp-route-id="@item.Id" method="post" class="flex-fill">
                                    <button type="submit" class="btn btn-danger btn-sm w-100 fw-bold">
                                        &cross; Reject
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
