@{
    ViewData["Title"] = "Admin Dashboard";
    int totalStudents = ViewBag.TotalStudents ?? 0;
    int totalItems = ViewBag.TotalItems ?? 0;
    int pendingItems = ViewBag.PendingItems ?? 0;
    int approvedItems = ViewBag.ApprovedItems ?? 0;
    int rejectedItems = ViewBag.RejectedItems ?? 0;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Admin Dashboard</h1>
            <p class="text-muted mb-0">Overview of students, items, and pending approval requests</p>
        </div>
        <span class="badge bg-danger px-3 py-2 fs-6">Administrator Portal</span>
    </div>

    <!-- Summary Cards -->
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-5 g-3 mb-4">
        <div class="col">
            <div class="card shadow-sm border-0 h-100 bg-white">
                <div class="card-body text-center p-3">
                    <div class="text-muted small fw-semibold text-uppercase mb-1">Total Students</div>
                    <div class="display-6 fw-bold text-dark">@totalStudents</div>
                    <a asp-area="Admin" asp-controller="Students" asp-action="Index" class="btn btn-sm btn-outline-primary mt-3 w-100">
                        View Students
                    </a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card shadow-sm border-0 h-100 bg-white">
                <div class="card-body text-center p-3">
                    <div class="text-muted small fw-semibold text-uppercase mb-1">Total Items</div>
                    <div class="display-6 fw-bold text-secondary">@totalItems</div>
                    <a asp-area="Admin" asp-controller="Items" asp-action="Index" class="btn btn-sm btn-outline-secondary mt-3 w-100">
                        View All Items
                    </a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card shadow-sm border-0 h-100 bg-warning-subtle text-dark">
                <div class="card-body text-center p-3">
                    <div class="text-warning-emphasis small fw-bold text-uppercase mb-1">Pending Approval</div>
                    <div class="display-6 fw-bold text-warning-emphasis">@pendingItems</div>
                    <a asp-area="Admin" asp-controller="Items" asp-action="Pending" class="btn btn-sm btn-warning fw-bold mt-3 w-100">
                        Review Pending
                    </a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card shadow-sm border-0 h-100 bg-success-subtle text-dark">
                <div class="card-body text-center p-3">
                    <div class="text-success-emphasis small fw-semibold text-uppercase mb-1">Approved Items</div>
                    <div class="display-6 fw-bold text-success">@approvedItems</div>
                    <a asp-area="Admin" asp-controller="Items" asp-action="Approved" class="btn btn-sm btn-outline-success mt-3 w-100">
                        View Approved
                    </a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card shadow-sm border-0 h-100 bg-danger-subtle text-dark">
                <div class="card-body text-center p-3">
                    <div class="text-danger-emphasis small fw-semibold text-uppercase mb-1">Rejected Items</div>
                    <div class="display-6 fw-bold text-danger">@rejectedItems</div>
                    <a asp-area="Admin" asp-controller="Items" asp-action="Rejected" class="btn btn-sm btn-outline-danger mt-3 w-100">
                        View Rejected
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Navigation Actions -->
    <div class="card shadow-sm border-0 mb-4 bg-white">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="fw-bold mb-0">Quick Management Actions</h5>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="p-3 border rounded bg-light h-100">
                        <h6 class="fw-bold text-primary">Student Management</h6>
                        <p class="text-muted small mb-3">View registered student profiles and their shared resource history.</p>
                        <a asp-area="Admin" asp-controller="Students" asp-action="Index" class="btn btn-primary btn-sm fw-semibold">
                            Manage Students &rarr;
                        </a>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 border rounded bg-light h-100">
                        <h6 class="fw-bold text-warning-emphasis">Item Approvals</h6>
                        <p class="text-muted small mb-3">Review items submitted by students awaiting moderator approval.</p>
                        <a asp-area="Admin" asp-controller="Items" asp-action="Pending" class="btn btn-warning btn-sm fw-bold">
                            Review Pending Items (@pendingItems) &rarr;
                        </a>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 border rounded bg-light h-100">
                        <h6 class="fw-bold text-secondary">All Catalog Items</h6>
                        <p class="text-muted small mb-3">Browse all resources in the system across all approval states.</p>
                        <a asp-area="Admin" asp-controller="Items" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            View Resource Catalog &rarr;
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
